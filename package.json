{
  "name": "matrix-block-canvas",
  "version": "1.0.0",
  "description": "Client-side matrix block figure maker for TSV and categorical data.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "portable:from-build": "node scripts/make-portable.mjs",
    "portable": "npm run build && npm run portable:from-build",
    "check": "npm run typecheck && npm run build && npm run portable:from-build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "typescript": "^5.6.3",
    "vite": "8.2.0"
  }
}
